{
{%- set asic_cnt = asic_cnt|int -%}
{%- macro macsec_profile_body() -%}
        "priority": "{{priority}}",
        "cipher_suite": "{{cipher_suite}}",
        "primary_cak": "{{primary_cak}}",
        "primary_ckn": "{{primary_ckn}}",
{% if fallback_cak is defined and fallback_ckn is defined %}
        "fallback_cak": "{{fallback_cak}}",
        "fallback_ckn": "{{fallback_ckn}}",
{% endif %}
        "policy": "{{policy}}",
        "send_sci": "{{send_sci}}"
{%- endmacro -%}
{% if asic_cnt > 1 %}
  "localhost": {
    "MACSEC_PROFILE": {}
  },
{% for ns in range(asic_cnt) %}
  "asic{{ns}}": {
    "MACSEC_PROFILE": {
      "{{macsec_profile}}": {
{{ macsec_profile_body() }}
      }
    }
{% if ns == asic_cnt-1 %}
  }
{% else %}
  },
{% endif %}
{%- endfor -%}
{% else %}
  "MACSEC_PROFILE": {
      "{{macsec_profile}}": {
{{ macsec_profile_body() }}
      }
    }
{%- endif -%}
}
